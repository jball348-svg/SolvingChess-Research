# Local environments, build products and temporary experiment data.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
pilot/tmp/
pilot/cache/
pilot/runs/
pilot/.work/

# Keep selected measurements, reproducible source and small certificates tracked.
# Bulk generated truth must have a regeneration command or durable locator.
.env
.env.*
!.env.example
*.pem
*.key
.DS_Store
