{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solving-chess.local/schemas/g_completion.schema.json",
  "title": "One-G Codex completion record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "programme",
    "status",
    "gate_result",
    "state_transition",
    "handoff_path",
    "freeze_manifest_path",
    "program_state_path",
    "tests_run",
    "validation_summary",
    "blockers",
    "next_programme",
    "next_programme_authorized",
    "human_input_required",
    "human_input_reason",
    "final_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "programme": {
      "$ref": "#/$defs/programme"
    },
    "status": {
      "enum": [
        "PASS",
        "HOLD",
        "BLOCKED",
        "FAILED"
      ]
    },
    "gate_result": {
      "enum": [
        "PASS",
        "HOLD",
        "BLOCKED",
        "FAILED"
      ]
    },
    "state_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/programme"
        },
        "to": {
          "$ref": "#/$defs/programme"
        }
      }
    },
    "handoff_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "freeze_manifest_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "program_state_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
      "const": "state/PROGRAM_STATE.json"
    },
    "tests_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_code",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "checks"
      ],
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "HOLD",
            "BLOCKED",
            "FAILED"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_programme": {
      "oneOf": [
        {
          "$ref": "#/$defs/programme"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_programme_authorized": {
      "type": "boolean"
    },
    "human_input_required": {
      "type": "boolean"
    },
    "human_input_reason": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "final_summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/programmeTransition"
    },
    {
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "PASS"
            },
            "gate_result": {
              "const": "PASS"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "HOLD"
            },
            "gate_result": {
              "const": "HOLD"
            }
          }
        },
        {
