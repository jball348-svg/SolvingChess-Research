              "const": "BLOCKED"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "FAILED"
            },
            "gate_result": {
              "const": "FAILED"
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "$ref": "#/$defs/passSuccessor",
        "properties": {
          "validation_summary": {
            "properties": {
              "result": {
                "const": "PASS"
              }
            },
            "required": [
              "result"
            ]
          }
        }
      },
      "else": {
        "$ref": "#/$defs/stoppedCurrentProgramme"
      }
    },
    {
      "if": {
        "properties": {
          "human_input_required": {
            "const": true
          }
        },
        "required": [
          "human_input_required"
        ]
      },
      "then": {
        "properties": {
          "human_input_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
