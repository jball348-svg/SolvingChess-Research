{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solving-chess.local/schemas/artifact_registry.schema.json",
  "title": "Solving Chess migration artifact registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_kind",
    "generated_at",
    "source_summary",
    "contents",
    "occurrences",
    "archive_members",
    "expected_missing",
    "audits"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registry_kind": {
      "const": "MIGRATION_ARTIFACT_REGISTRY"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_summary": {
      "type": "object",
      "required": [
        "expected_count",
        "expected_total_bytes",
        "expected_nameset_sha256",
        "observed_count",
        "observed_total_bytes",
        "observed_unique_content_count",
        "observed_duplicate_occurrence_count",
        "observed_nameset_sha256",
        "selection_policy"
      ],
      "additionalProperties": true,
      "properties": {
        "expected_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "expected_total_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "expected_nameset_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observed_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "observed_total_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "observed_unique_content_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "observed_duplicate_occurrence_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "observed_nameset_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selection_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "content_id",
          "sha256",
          "size",
          "media_type",
          "occurrence_ids",
          "immutability"
        ],
        "additionalProperties": true,
        "properties": {
          "content_id": {
            "$ref": "#/$defs/contentId"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size": {
            "$ref": "#/$defs/nonNegativeInteger"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "occurrence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "immutability": {
            "enum": [
              "FROZEN_ORIGINAL_BYTES"
            ]
          }
        }
      }
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_name",
          "repository_path",
          "sha256",
          "size",
          "role",
          "availability"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_name": {
            "type": "string",
            "minLength": 1
          },
          "repository_path": {
            "$ref": "#/$defs/repositoryPath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size": {
            "$ref": "#/$defs/nonNegativeInteger"
          },
          "role": {
            "enum": [
              "ROADMAP_OR_STRATEGIC_DOCUMENT",
              "TECHNICAL_HANDOFF",
              "HUMAN_DOCUMENT",
              "ARCHIVE",
              "BINARY_ARTIFACT",
              "MACHINE_OR_LEDGER_ARTIFACT",
              "SOURCE_CODE",
              "HUMAN_OR_LEDGER_DOCUMENT",
              "LEGACY_ARTIFACT"
            ]
          },
          "availability": {
            "enum": [
              "PRESENT",
              "RECOVERED_EXACT_BYTES",
              "EXTERNAL_REFERENCE",
              "UNAVAILABLE"
            ]
          },
          "content_id": {
            "$ref": "#/$defs/contentId"
          },
          "programme": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^(?:PILOT|G(?:[1-9]|[1-3][0-9]|4[0-2]))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "archive_members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "container_occurrence_id",
          "container_sha256",
          "path",
          "size",
          "sha256",
          "availability"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "container_occurrence_id": {
            "type": "string",
            "minLength": 1
          },
          "container_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "$ref": "#/$defs/nonNegativeInteger"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "content_id": {
            "$ref": "#/$defs/contentId"
          },
          "availability": {
            "enum": [
              "PRESENT_INSIDE_ARCHIVE"
            ]
          }
        }
      }
    },
    "expected_missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_name",
          "sha256",
          "availability"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_name": {
            "type": "string",
            "minLength": 1
          },
          "repository_path": {
            "oneOf": [
              {
                "$ref": "#/$defs/repositoryPath"
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size": {
            "oneOf": [
              {
                "$ref": "#/$defs/nonNegativeInteger"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "enum": [
              "EXPECTED_HISTORICAL_ARTIFACT"
            ]
          },
          "availability": {
            "enum": [
              "EXPECTED_ONLY_MISSING_FROM_MIGRATION_INPUT",
              "RECOVERED_EXACT_BYTES",
              "UNAVAILABLE"
            ]
          },
          "content_id": {
            "$ref": "#/$defs/contentId"
          },
          "programme": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^(?:PILOT|G(?:[1-9]|[1-3][0-9]|4[0-2]))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "referenced_by": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "checksum_file",
                "line"
              ],
              "additionalProperties": true,
              "properties": {
                "checksum_file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "integrity_status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "audits": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contentId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    }
  }
}
